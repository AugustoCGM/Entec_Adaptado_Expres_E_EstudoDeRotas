<!-- Seção Hero (Carrossel Dinâmico) -->
<section id="hero-section" class="relative pt-28 pb-12 md:pt-32 md:pb-16 min-h-[75vh] flex flex-col justify-center bg-checkerboard border-b-4 border-black overflow-hidden">
    <div class="w-full max-w-6xl mx-auto relative z-10 flex-grow flex flex-col justify-center">
        <!-- Logo Flutuante Inteligente -->
        <div id="floating-hero-logo" class="logo-state-center pointer-events-none">
            <img src="/assets/logo-hero.png" alt="ENTEC E-Sports">
        </div>

        <!-- Setas de Controle -->
        <div class="absolute left-0 md:left-4 top-1/2 -translate-y-1/2 z-30 hidden md:block">
            <button id="prev-hero" class="bg-white border-4 border-black brutal-shadow-sm hover-brutal w-10 h-10 md:w-14 md:h-14 flex items-center justify-center cursor-pointer">
                <i data-lucide="arrow-left" class="w-6 h-6 md:w-8 md:h-8"></i>
            </button>
        </div>
        <div class="absolute right-0 md:right-4 top-1/2 -translate-y-1/2 z-30 hidden md:block">
            <button id="next-hero" class="bg-white border-4 border-black brutal-shadow-sm hover-brutal w-10 h-10 md:w-14 md:h-14 flex items-center justify-center cursor-pointer">
                <i data-lucide="arrow-right" class="w-6 h-6 md:w-8 md:h-8"></i>
            </button>
        </div>

        <!-- Máscara do Carrossel -->
        <div class="overflow-hidden w-full relative mb-8">
            <div id="hero-track" class="flex transition-transform duration-700 ease-in-out items-center">
                <div class="w-full flex-shrink-0 flex flex-col items-center justify-between h-[400px] md:h-[500px] text-center px-4 md:px-24">
                    <div class="pt-2 md:pt-6 w-full flex justify-center z-10">
                        <a href="https://www.instagram.com/uninassau.cg?stkn=czRxdHRma3d5dTlx" target="_blank" rel="noopener noreferrer" class="inline-block bg-white border-4 border-black px-4 py-2 brutal-shadow-sm transform -rotate-2 hover-brutal cursor-pointer">
                            <img src="/assets/logo-uninassau.png" alt="UNINASSAU" class="h-5 md:h-8 object-contain">
                        </a>
                    </div>
                    <div class="pb-2 md:pb-6 w-full flex justify-center z-10">
                        <div class="bg-[#fdfbf7] border-4 border-black p-3 md:px-6 inline-block brutal-shadow-sm transform skew-x-2">
                            <p class="text-sm sm:text-base md:text-xl font-bold uppercase leading-tight md:leading-snug">
                                Desperte seu superpoder e <br class="hidden md:block"/> 
                                domine o código da vitória!
                            </p>
                        </div>
                    </div>
                </div>

                <div class="w-full flex-shrink-0 flex flex-col items-center justify-center py-4 px-6">
                    <div class="relative w-full max-w-[280px] md:max-w-[340px] bg-white border-4 border-black brutal-shadow p-2 md:p-3 mx-auto">
                        <img src="/assets/post-1.png" alt="Divulgação 1" class="w-full aspect-[4/5] object-cover border-2 border-black bg-gray-200 pointer-events-none">
                    </div>
                </div>

                <div class="w-full flex-shrink-0 flex flex-col items-center justify-center py-4 px-6">
                    <div class="relative w-full max-w-[280px] md:max-w-[340px] bg-white border-4 border-black brutal-shadow p-2 md:p-3 mx-auto">
                        <img src="/assets/post-2.png" alt="Divulgação 2" class="w-full aspect-[4/5] object-cover border-2 border-black bg-gray-200 pointer-events-none">
                    </div>
                </div>

                <div class="w-full flex-shrink-0 flex flex-col items-center justify-center py-4 px-6">
                    <div class="relative w-full max-w-[280px] md:max-w-[340px] bg-white border-4 border-black brutal-shadow p-2 md:p-3 mx-auto">
                        <img src="/assets/post-3.png" alt="Divulgação 3" class="w-full aspect-[4/5] object-cover border-2 border-black bg-gray-200 pointer-events-none">
                    </div>
                </div>
            </div>
        </div>

        <div id="hero-dots" class="flex justify-center items-center gap-4 mb-4 md:mb-6"></div>
    </div>

    <!-- Botões Constantes Fixos -->
    <div class="flex flex-col sm:flex-row gap-4 md:gap-6 justify-center w-full relative z-20 mt-auto">
        <a href="#fc26" class="w-4/5 sm:w-auto mx-auto sm:mx-0 bg-[#0055ff] text-white relative inline-flex items-center justify-center px-6 md:px-10 py-3 md:py-4 font-black uppercase text-base md:text-xl border-4 border-black brutal-shadow hover-brutal cursor-pointer">
            Torneio EA FC 26
        </a>
        <a href="#mk11" class="w-4/5 sm:w-auto mx-auto sm:mx-0 bg-[#ff00ff] text-white relative inline-flex items-center justify-center px-6 md:px-10 py-3 md:py-4 font-black uppercase text-base md:text-xl border-4 border-black brutal-shadow hover-brutal cursor-pointer">
            Torneio MK 11
        </a>
    </div>
</section>

<!-- Faixa Animada (Marquee) -->
