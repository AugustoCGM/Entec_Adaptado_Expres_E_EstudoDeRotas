<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if titulo}}{{titulo}} | {{/if}}ENTEC UNINASSAU 2026</title>
    <link rel="icon" type="image/png" href="/assets/favicon.png">
    
    <!-- Fonte Space Grotesk -->
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;900&display=swap" rel="stylesheet">
    
    <!-- Ícones Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- CSS Externo (rotas /css configuradas no server.js) -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/brutalism.css">
</head>
<body class="selection:bg-[#ff00ff] selection:text-white">

    <!-- Cursor Customizado -->
    <div id="custom-cursor"></div>

    <!-- Navegação Superior -->
    <nav class="fixed top-0 w-full z-50 bg-[#fdfbf7] border-b-4 border-black py-4 px-6 md:px-12 flex justify-between items-center">
        <div class="flex items-center gap-4 md:gap-6">
            <a href="/">
                <img src="/assets/logo-entec.png" alt="Logo ENTEC 2026" class="h-5 md:h-7 object-contain cursor-pointer hover-brutal">
            </a>
            <div class="w-1 h-5 bg-black transform rotate-12"></div>
            <a href="https://www.instagram.com/jamlabsdev?stkn=OTRqNHBzbjYya3My" target="_blank" rel="noopener noreferrer">
                <img src="/assets/logo-jamlabs.png" alt="Logo JAM Labs" class="h-5 md:h-7 object-contain cursor-pointer hover-brutal">
            </a>
        </div>
        <div class="hidden md:flex gap-6 font-bold uppercase">
            <a href="/#fc26" class="hover:text-[#0055ff] transition-colors hover:underline decoration-4 underline-offset-4">EA FC 26</a>
            <a href="/#mk11" class="hover:text-[#ff00ff] transition-colors hover:underline decoration-4 underline-offset-4">Mortal Kombat 11</a>
        </div>
    </nav>

    <!-- Conteúdo Dinâmico das Views -->
    {{{body}}}

    <!-- Botão Flutuante (Ações Rápidas) -->
    <div class="fixed bottom-6 right-6 z-[100] flex flex-col items-center gap-4">
        <div id="fab-menu" class="flex flex-col gap-4 items-center opacity-0 translate-y-8 pointer-events-none transition-all duration-300 origin-bottom mb-2">
            <div class="group relative flex items-center">
                <span class="absolute right-full mr-4 bg-white text-black font-black uppercase px-3 py-1 text-sm border-2 border-black opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none translate-x-2 group-hover:translate-x-0 whitespace-nowrap brutal-shadow-sm">
                    Regras FC 26
                </span>
                <a href="/eafc/regras" class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#0055ff] border-[3px] border-black brutal-shadow-sm hover-brutal flex items-center justify-center overflow-hidden p-2 md:p-2.5 cursor-pointer">
                    <img src="/assets/logo-fc-circle.png" alt="FC 26" class="w-full h-full object-contain">
                </a>
            </div>
            <div class="group relative flex items-center">
                <span class="absolute right-full mr-4 bg-white text-black font-black uppercase px-3 py-1 text-sm border-2 border-black opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none translate-x-2 group-hover:translate-x-0 whitespace-nowrap brutal-shadow-sm">
                    Regras MK 11
                </span>
                <a href="/mk11/regras" class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#ff00ff] border-[3px] border-black brutal-shadow-sm hover-brutal flex items-center justify-center overflow-hidden p-2 md:p-2.5 cursor-pointer">
                    <img src="/assets/logo-mk-circle.png" alt="MK 11" class="w-full h-full object-contain">
                </a>
            </div>
            <div class="group relative flex items-center">
                <span class="absolute right-full mr-4 bg-white text-black font-black uppercase px-3 py-1 text-sm border-2 border-black opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none translate-x-2 group-hover:translate-x-0 whitespace-nowrap brutal-shadow-sm">
                    Instagram UNINASSAU
                </span>
                <a href="https://www.instagram.com/uninassau.cg?stkn=czRxdHRma3d5dTlx" target="_blank" rel="noopener noreferrer" class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#00cc66] border-[3px] border-black brutal-shadow-sm hover-brutal flex items-center justify-center overflow-hidden p-2 md:p-2.5 cursor-pointer">
                    <img src="/assets/logo-nassau-circle.png" alt="UNINASSAU" class="w-full h-full object-contain">
                </a>
            </div>
            <div class="group relative flex items-center">
                <span class="absolute right-full mr-4 bg-white text-black font-black uppercase px-3 py-1 text-sm border-2 border-black opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none translate-x-2 group-hover:translate-x-0 whitespace-nowrap brutal-shadow-sm">
                    Instagram JAM Labs
                </span>
                <a href="https://www.instagram.com/jamlabsdev?stkn=OTRqNHBzbjYya3My" target="_blank" rel="noopener noreferrer" class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-white border-[3px] border-black brutal-shadow-sm hover-brutal flex items-center justify-center overflow-hidden p-2 md:p-2.5 cursor-pointer">
                    <img src="/assets/logo-jamlabs.png" alt="JAM Labs" class="w-full h-full object-contain">
                </a>
            </div>
        </div>
        <button id="fab-btn" class="group relative w-20 h-20 md:w-24 md:h-24 outline-none brutal-white-outline transition-transform active:scale-95 cursor-pointer">
            <img src="/assets/quadrado.png" alt="Fundo" class="absolute inset-0 w-full h-full object-contain z-0">
            <img id="fab-star" src="/assets/estrela.png" alt="Estrela" class="absolute inset-0 w-full h-full object-contain z-10 transition-all duration-500 ease-in-out transform group-hover:rotate-90 group-[.is-open]:rotate-180 group-[.is-open]:opacity-0 group-[.is-open]:scale-50">
            <img id="fab-controller" src="/assets/controle.png" alt="Comando" class="absolute inset-0 w-full h-full object-contain z-20 transition-all duration-500 ease-in-out transform -rotate-180 opacity-0 scale-50 group-[.is-open]:rotate-0 group-[.is-open]:opacity-100 group-[.is-open]:scale-100">
        </button>
    </div>

    <!-- Rodapé -->
    <footer class="bg-black text-white pt-12 pb-8 px-6 md:px-12 border-t-8 border-[#00cc66]">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8 text-center md:text-left mb-10">
            <div class="flex-shrink-0">
                <img src="/assets/logo-entec-footer.png" alt="ENTEC 2026" class="h-16 md:h-20 w-auto object-contain mx-auto md:mx-0">
            </div>
            <div class="font-bold text-gray-400 max-w-sm">
                <p>14ª Edição do Encontro de Tecnologia</p>
                <p class="mt-2 text-sm leading-relaxed">IA no fluxo de DEVOPS + O mundo dos agentes de IA: autonomia, decisão e o futuro do dev</p>
            </div>
        </div>
        <div class="max-w-6xl mx-auto border-t-2 border-gray-800 pt-8 mt-4 flex flex-col items-center justify-center gap-4">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">Realização & Apoio</p>
            <div class="flex items-center gap-8 opacity-80 hover:opacity-100 transition-opacity">
                <a href="https://www.instagram.com/uninassau.cg?stkn=czRxdHRma3d5dTlx" target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform cursor-pointer">
                    <img src="/assets/logo-nassau-footer.png" alt="UNINASSAU" class="h-6 md:h-8 w-auto object-contain">
                </a>
                <a href="https://www.instagram.com/jamlabsdev?stkn=OTRqNHBzbjYya3My" target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform cursor-pointer">
                    <img src="/assets/logo-jam-footer.png" alt="JAM Labs" class="h-6 md:h-8 w-auto object-contain">
                </a>
            </div>
        </div>
    </footer>

    <!-- Scripts Externos (rotas /js configuradas no server.js) -->
    <script src="/js/script.js"></script>
    <script src="/js/cursor.js"></script>
    <script src="/js/fab.js"></script>
</body>
</html>