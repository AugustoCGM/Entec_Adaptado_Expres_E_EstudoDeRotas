<section class="bg-checkerboard min-h-screen pt-28 pb-20 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
        
        <!-- Cabeçalho da Página -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10">
            <div>
                <span class="inline-block text-white font-black uppercase px-4 py-1 border-4 border-black brutal-shadow-sm mb-2" style="background-color: {{corTema}};">
                    Inscrições Oficiais
                </span>
                <h1 class="text-4xl md:text-5xl font-black uppercase">{{nomeTorneio}}</h1>
            </div>
            <div class="flex gap-3">
                <a href="{{rotaBase}}/regras" class="bg-white text-black px-5 py-3 font-black uppercase border-4 border-black brutal-shadow-sm hover-brutal">
                    Regulamento
                </a>
                <a href="/" class="bg-[#00cc66] text-black px-5 py-3 font-black uppercase border-4 border-black brutal-shadow-sm hover-brutal">
                    Voltar ao Início
                </a>
            </div>
        </div>

        <div class="grid md:grid-cols-12 gap-8 items-start">
            
            <!-- Formulário de Cadastro (CREATE) -->
            <div class="md:col-span-5 bg-white border-4 border-black p-6 md:p-8 brutal-shadow">
                <h2 class="text-2xl font-black uppercase mb-6" style="color: {{corTema}};">
                    Cadastrar Nova Dupla
                </h2>
                <form action="{{rotaBase}}/inscrever" method="POST" class="space-y-4 font-bold">
                    <div>
                        <label class="block text-sm uppercase font-black mb-1">Nome da Dupla</label>
                        <input type="text" name="nomeDupla" placeholder="Ex: Os Invencíveis" required class="w-full border-4 border-black p-3 bg-[#fdfbf7] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-sm uppercase font-black mb-1">Jogador 1</label>
                        <input type="text" name="jogador1" placeholder="Nome completo ou Nick" required class="w-full border-4 border-black p-3 bg-[#fdfbf7] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-sm uppercase font-black mb-1">Jogador 2</label>
                        <input type="text" name="jogador2" placeholder="Nome completo ou Nick" required class="w-full border-4 border-black p-3 bg-[#fdfbf7] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-sm uppercase font-black mb-1">Contato (WhatsApp / Instagram)</label>
                        <input type="text" name="contato" placeholder="Ex: @dupla_entec" required class="w-full border-4 border-black p-3 bg-[#fdfbf7] focus:outline-none">
                    </div>
                    <button type="submit" class="w-full text-white py-4 font-black uppercase text-lg border-4 border-black brutal-shadow-sm hover-brutal cursor-pointer mt-2" style="background-color: {{corTema}};">
                        Confirmar Inscrição
                    </button>
                </form>
            </div>

            <!-- Listagem, Edição e Exclusão (READ / UPDATE / DELETE) -->
            <div class="md:col-span-7 bg-white border-4 border-black p-6 md:p-8 brutal-shadow">
                <div class="flex justify-between items-center mb-6 border-b-4 border-black pb-4">
                    <h2 class="text-2xl font-black uppercase">Duplas Confirmadas</h2>
                    <span class="bg-black text-white font-black px-3 py-1 text-lg">
                        {{inscritos.length}}
                    </span>
                </div>

                <div class="space-y-4">
                    {{#each inscritos}}
                    <div class="border-4 border-black p-4 bg-[#fdfbf7]">
                        <div class="flex flex-wrap justify-between items-start gap-4">
                            <div>
                                <h3 class="text-xl font-black uppercase">{{nomeDupla}}</h3>
                                <p class="font-bold text-gray-800 mt-1">
                                    <span class="uppercase text-xs bg-white border-2 border-black px-2 py-0.5 mr-1">Dupla</span>
                                    {{jogador1}} & {{jogador2}}
                                </p>
                                <p class="text-sm font-bold text-gray-600 mt-1">Contato: {{contato}}</p>
                            </div>

                            <!-- Botão Excluir (DELETE) -->
                            <form action="{{../rotaBase}}/deletar/{{id}}" method="POST">
                                <button type="submit" class="bg-red-500 text-white px-3 py-1.5 text-xs font-black uppercase border-2 border-black brutal-shadow-sm hover-brutal cursor-pointer">
                                    Remover
                                </button>
                            </form>
                        </div>

                        <!-- Formulário Retrátil de Edição (UPDATE) -->
                        <details class="mt-3 pt-3 border-t-2 border-black">
                            <summary class="text-xs font-black uppercase cursor-pointer select-none hover:underline">
                                Editar dados da dupla
                            </summary>
                            <form action="{{../rotaBase}}/editar/{{id}}" method="POST" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 font-bold text-sm">
                                <input type="text" name="nomeDupla" value="{{nomeDupla}}" required class="border-2 border-black p-2 bg-white">
                                <input type="text" name="contato" value="{{contato}}" required class="border-2 border-black p-2 bg-white">
                                <input type="text" name="jogador1" value="{{jogador1}}" required class="border-2 border-black p-2 bg-white">
                                <input type="text" name="jogador2" value="{{jogador2}}" required class="border-2 border-black p-2 bg-white">
                                <button type="submit" class="sm:col-span-2 bg-[#00cc66] text-black py-2 font-black uppercase border-2 border-black cursor-pointer">
                                    Salvar Alterações
                                </button>
                            </form>
                        </details>
                    </div>
                    {{else}}
                    <div class="border-4 border-dashed border-black p-8 text-center bg-[#fdfbf7]">
                        <p class="font-black uppercase text-lg text-gray-600">Nenhuma dupla inscrita neste torneio ainda.</p>
                        <p class="font-bold text-sm text-gray-500 mt-1">Preencha o formulário ao lado para garantir a primeira vaga!</p>
                    </div>
                    {{/each}}
                </div>
            </div>

        </div>
    </div>
</section>